{
  "name": "credentials-stub",
  "version": "0.1.0",
  "description": "External credentials provider: a Vault-style KV endpoint implementing credentials@1",
  "entry": "index.ts",
  "capabilities": [{ "id": "credentials", "version": 1, "provider": "stub-vault" }],
  "config": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "description": "Base URL of the Vault-style endpoint" },
      "mount": { "type": "string", "default": "secret" },
      "token": { "type": "string", "description": "sent as X-Vault-Token; never logged" },
      "timeoutMs": { "type": "number", "default": 5000 }
    },
    "required": ["url"]
  }
}
